    {
      "parameters": {
        "jsCode": "// Build optimized Google Places search query from form inputs\nconst formData = $input.item.json;\n\nconst businessType = formData['Business Type']?.trim() || '';\nconst city = formData['City/Location']?.trim() || '';\nconst additionalKeywords = formData['Additional Keywords (Optional)']?.trim() || '';\nconst userEmail = formData['Your Email']?.trim() || '';\n\n// Validate required fields\nif (!businessType || !city || !userEmail) {\n  throw new Error('Missing required fields: Business Type, City/Location, or Email');\n}\n\n// Build search query - Google Places works best with simple queries\nlet searchParts = [businessType];\nif (additionalKeywords) {\n  searchParts.push(additionalKeywords);\n}\nsearchParts.push(city);\n\n// Join with + for URL compatibility\nconst searchQuery = searchParts.join('+').replace(/\\s+/g, '+');\n\n// Generate unique sheet name based on search\nconst timestamp = new Date().toISOString().slice(0, 10);\nconst sheetName = `${businessType} - ${city} - ${timestamp}`.substring(0, 50);\n\nreturn {\n  searchQuery,\n  city,\n  businessType,\n  userEmail,\n  sheetName,\n  submittedAt: new Date().toISOString(),\n  // Initialize pagination state\n  currentPage: 1,\n  maxPages: 5,\n  nextPageToken: null\n};"
      },
      "id": "build-search-query",
      "name": "Build Search Query",
      "type": "n8n-nodes-base.code",
      "position": [-640, 2752],
      "typeVersion": 2
    },
    {
