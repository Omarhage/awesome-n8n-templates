              "value": "places.displayName,places.formattedAddress,places.websiteUri,places.nationalPhoneNumber,nextPageToken"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"textQuery\": \"{{ $json.searchQuery }}\",\n  \"maxResultCount\": 20\n  {{ $json.nextPageToken ? ', \"pageToken\": \"' + $json.nextPageToken + '\"' : '' }}\n}",
        "options": {
