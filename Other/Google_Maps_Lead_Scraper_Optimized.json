      "parameters": {
        "jsCode": "// Prepare initial search parameters with spreadsheet info\nconst buildQuery = $('Build Search Query').item.json;\nconst createSheet = $('Create User Sheet').item.json;\n\nreturn {\n  searchQuery: buildQuery.searchQuery,\n  city: buildQuery.city,\n  businessType: buildQuery.businessType,\n  userEmail: buildQuery.userEmail,\n  currentPage: 1,\n  maxPages: 5,\n  nextPageToken: null,\n  spreadsheetId: createSheet.spreadsheetId,\n  spreadsheetUrl: createSheet.spreadsheetUrl,\n  sheetTitle: createSheet.sheets?.[0]?.properties?.title || 'Sheet1'\n};"
      },
