      "id": "get-places-from-google",
      "name": "Get Places from Google",
      "type": "n8n-nodes-base.httpRequest",
      "position": [704, 2752],
      "typeVersion": 4.2,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Extract places and handle API response\nconst response = $input.item.json;\nconst searchParams = $('Prepare API Request').item.json;\n\n// Check for API errors\nif (response.error || !response.places) {\n  console.log('⚠️ Google Places API error or no results');\n  return [{\n    json: {\n      places: [],\n      hasMore: false,\n      searchParams: searchParams,\n      error: response.error?.message || 'No places found'\n    }\n  }];\n}\n\nconst places = response.places || [];\nconst nextPageToken = response.nextPageToken || null;\nconst currentPage = searchParams.currentPage || 1;\nconst maxPages = searchParams.maxPages || 5;\n\nconsole.log(`📍 Found ${places.length} places on page ${currentPage}`);\n\n// Process places into clean format\nconst processedPlaces = places.map(place => ({\n  displayName: place.displayName?.text || place.displayName || 'Unknown',\n  formattedAddress: place.formattedAddress || '',\n  nationalPhoneNumber: place.nationalPhoneNumber || '',\n  websiteUri: place.websiteUri || ''\n}));\n\nreturn [{\n  json: {\n    places: processedPlaces,\n    hasMore: !!(nextPageToken && currentPage < maxPages),\n    nextPageToken: nextPageToken,\n    currentPage: currentPage,\n    searchParams: {\n      ...searchParams,\n      currentPage: currentPage + 1,\n      nextPageToken: nextPageToken\n    }\n  }\n}];"
      },
      "id": "process-places-response",
      "name": "Process Places Response",
      "type": "n8n-nodes-base.code",
      "position": [928, 2752],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "// Split places into individual items for processing\nconst data = $input.item.json;\nconst places = data.places || [];\nconst searchParams = data.searchParams;\n\nif (places.length === 0) {\n  return [{\n    json: {\n      isEmpty: true,\n      searchParams: searchParams\n    }\n  }];\n}\n\n// Output each place as separate item with search context\nreturn places.map(place => ({\n  json: {\n    ...place,\n    city: searchParams.city,\n    spreadsheetId: searchParams.spreadsheetId,\n    spreadsheetUrl: searchParams.spreadsheetUrl,\n    sheetTitle: searchParams.sheetTitle,\n    userEmail: searchParams.userEmail,\n    businessType: searchParams.businessType\n  }\n}));"
      },
